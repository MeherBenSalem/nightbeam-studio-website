# ------------------------------------------------------------------
# NightBeam Studio Website — environment variables
# Copy to .env (local) and fill in what you have. Features degrade
# gracefully when secrets are missing.
# ------------------------------------------------------------------

# --- Core ---
APP_URL=http://localhost:3000
APP_NAME=NightBeam Studio

# --- Data backend -------------------------------------------------
# auto  = use PostgreSQL when DATABASE_URL is reachable, otherwise
#         fall back to the seeded in-memory catalog (zero-setup dev)
# prisma = require PostgreSQL (fails visibly when unreachable)
# memory = always use the in-memory catalog (tests, quick previews)
DATA_BACKEND=auto
DATABASE_URL=postgresql://nightbeam:nightbeam@localhost:5432/nightbeam?schema=public
REDIS_URL=redis://localhost:6379
# Used by docker-compose.prod.yml
POSTGRES_PASSWORD=nightbeam

# --- Auth.js ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# OAuth providers — each is auto-disabled with a UI hint until both
# ID and secret are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Bootstrap super-admin (used by `npm run db:seed`; in memory mode
# the admin is created at startup when AUTH_ADMIN_EMAIL is set).
AUTH_ADMIN_EMAIL=admin@nightbeam.studio
AUTH_ADMIN_PASSWORD=ChangeMe_Strong_Passphrase_123!

# --- Email (verification, reset, notification digests) ------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=NightBeam Studio <no-reply@nightbeam.studio>
# In development without SMTP, newly registered accounts are
# auto-verified so flows can be tested locally. Set to false to
# require SMTP even in development.
DEV_AUTO_VERIFY=true

# --- Cloudflare Turnstile (optional) ------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- CurseForge (optional; sync is skipped without a key) ---------
CURSEFORGE_API_KEY=
CURSEFORGE_AUTHOR_ID=
CURSEFORGE_GAME_ID=432
# Redis cache TTLs in seconds
CACHE_TTL_PROJECTS=900
CACHE_TTL_DETAILS=1800
CACHE_TTL_STATS=600
CACHE_TTL_FILES=600

# --- Sync worker ---------------------------------------------------
SYNC_ENABLED=true
# cron expressions (UTC)
CRON_SYNC=*/30 * * * *
CRON_DIGEST=0 9 * * 1

# --- Community stats (static fallbacks) ----------------------------
COMMUNITY_DISCORD_URL=https://discord.gg/nightbeam
COMMUNITY_YOUTUBE_URL=https://www.youtube.com/@NightBeamStudio
COMMUNITY_GITHUB_URL=https://github.com/MeherBenSalem
COMMUNITY_DISCORD_MEMBERS=0
COMMUNITY_YOUTUBE_SUBSCRIBERS=0
COMMUNITY_GITHUB_STARS=0

# --- Analytics -----------------------------------------------------
# Self-hosted, privacy-friendly: controls whether /api/analytics
# accepts and stores events. Consent-gated client-side.
ANALYTICS_ENABLED=true

# --- Tests ----------------------------------------------------------
# Set in CI to run Prisma integration tests against a real Postgres.
TEST_DATABASE_URL=

# ------------------------------------------------------------------
# NightBeam Studio Website — environment variables
# Copy to .env (local) and fill in what you have. Features degrade
# gracefully when secrets are missing.
# ------------------------------------------------------------------

# --- Core ---
APP_URL=http://localhost:3000
APP_NAME=NightBeam Studio
# Caddy/nginx virtual host (production: nightbeam.dev)
SITE_DOMAIN=nightbeam.dev

# --- Data backend -------------------------------------------------
# auto  = use PostgreSQL when DATABASE_URL is reachable, otherwise
#         fall back to the seeded in-memory catalog (zero-setup dev)
# prisma = require PostgreSQL (fails visibly when unreachable)
# memory = always use the in-memory catalog (tests, quick previews)
DATA_BACKEND=auto
DATABASE_URL=postgresql://nightbeam:nightbeam@localhost:5432/nightbeam?schema=public
REDIS_URL=redis://localhost:6379
# Used by docker-compose.prod.yml
POSTGRES_PASSWORD=nightbeam

# --- Auth.js ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# OAuth providers — each is auto-disabled with a UI hint until both
# ID and secret are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Bootstrap super-admin (used by `npm run db:seed`; in memory mode
# the admin is created at startup when AUTH_ADMIN_EMAIL is set).
AUTH_ADMIN_EMAIL=admin@nightbeam.studio
AUTH_ADMIN_PASSWORD=ChangeMe_Strong_Passphrase_123!

# --- Email (verification, reset, notification digests) ------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=NightBeam Studio <no-reply@nightbeam.studio>
# In development without SMTP, newly registered accounts are
# auto-verified so flows can be tested locally. Set to false to
# require SMTP even in development.
DEV_AUTO_VERIFY=true
# Set false to disable public sign-ups (recommended while SMTP is not configured)
SIGNUPS_ENABLED=true

# --- Cloudflare Turnstile (optional) ------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- CurseForge (optional; sync is skipped without a key) ---------
CURSEFORGE_API_KEY=
CURSEFORGE_AUTHOR_ID=
CURSEFORGE_SEARCH_TERM=
CURSEFORGE_GAME_ID=432
# Landing hero video (latest channel video is auto-detected when unset)
YOUTUBE_VIDEO_ID=
YOUTUBE_CHANNEL_HANDLE=@nightbeamstudio
GOOGLE_API_KEY=
# Redis cache TTLs in seconds
CACHE_TTL_PROJECTS=900
CACHE_TTL_DETAILS=1800
CACHE_TTL_STATS=600
CACHE_TTL_FILES=600

# --- BuiltByBit (optional; sync is skipped without a token) ------------
BUILTBYBIT_API_TOKEN=
BUILTBYBIT_CLIENT_ID=
BUILTBYBIT_CLIENT_SECRET=
BUILTBYBIT_STORE_ID=272
BUILTBYBIT_MEMBER_ID=617578
# OAuth aliases (optional; CLIENT_ID/SECRET are preferred)
AUTH_BUILTBYBIT_ID=
AUTH_BUILTBYBIT_SECRET=

# --- Sync worker ---------------------------------------------------
SYNC_ENABLED=true
# cron expressions (UTC)
CRON_SYNC=*/30 * * * *
CRON_DIGEST=0 9 * * 1

# --- Community stats (static fallbacks) ----------------------------
COMMUNITY_DISCORD_URL=https://discord.gg/e4hRcaZM8G
COMMUNITY_YOUTUBE_URL=https://www.youtube.com/@nightbeamstudio
COMMUNITY_GITHUB_URL=https://github.com/MeherBenSalem?tab=repositories
COMMUNITY_DISCORD_MEMBERS=3000
COMMUNITY_YOUTUBE_SUBSCRIBERS=380
COMMUNITY_GITHUB_STARS=0

# --- Analytics -----------------------------------------------------
# Self-hosted, privacy-friendly: controls whether /api/analytics
# accepts and stores events. Consent-gated client-side.
ANALYTICS_ENABLED=true

# --- Chatbot (DeepSeek) ---------------------------------------------
# Chat is disabled until DEEPSEEK_API_KEY is set.
DEEPSEEK_API_KEY=
CHATBOT_ENABLED=true
CHATBOT_MODEL=deepseek-chat
# Anonymous visitors: questions allowed before sign-in
CHATBOT_ANON_LIMIT=2
# Logged-in free tier: questions per rolling window
CHATBOT_FREE_WINDOW_LIMIT=10
CHATBOT_FREE_WINDOW_MS=18000000
# Roles that get unlimited chat (in addition to User.isPro)
CHATBOT_PRO_ROLES=ADMIN,SUPER_ADMIN,SUPPORT_AGENT
CHATBOT_MAX_MESSAGE_LENGTH=2000
CHATBOT_MAX_OUTPUT_TOKENS=800
CHATBOT_MAX_CONTEXT_TOKENS=12000
CHATBOT_TEMPERATURE=0.3
CHATBOT_GUARD_ENABLED=true
# Comma-separated repo roots whose docs/**/*.md feed the knowledge base
# (used by `npm run kb:sync` and the memory-mode fallback loader).
CHATBOT_KB_ROOTS=C:/Users/mahou/OneDrive/Documents/GitHub/RPG-Attribute-System

# --- Tests ----------------------------------------------------------
# Set in CI to run Prisma integration tests against a real Postgres.
TEST_DATABASE_URL=

# --- Stripe (optional; Pro membership disabled without keys) --------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
# Client-readable publishable key (read via process.env in client code)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Donation recurring price IDs (create in Stripe dashboard)
STRIPE_PRICE_ID_DONATE_3=
STRIPE_PRICE_ID_DONATE_5=
STRIPE_PRICE_ID_DONATE_10=

# --- SEO ------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
